{
  "name": "evangelismo-digital-backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "license": "ISC",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "husky || true",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsup src/server.ts src/worker.ts --format cjs --clean",
    "start:dev": "npm run dev",
    "start:prod": "node dist/server.js",
    "start:worker": "tsx watch --env-file=.env src/worker.ts",
    "start:worker:prod": "node dist/worker.js",
    "format": "prettier --write \"src/**/*.{ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js}\"",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "lint": "eslint src/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:dev:default": "prisma migrate dev --name creating_database_models",
    "db:migrate:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:reset": "run-s db:generate db:migrate:reset db:seed",
    "db:migrate-deploy": "prisma migrate deploy",
    "db:deploy": "run-s db:migrate-deploy db:generate db:seed",
    "test:unit:use-cases": "vitest run --project unit-use-cases src/use-cases",
    "test:unit:churches": "vitest run --project unit-churches src/use-cases/churches",
    "test:unit:users": "vitest run --project unit-users src/use-cases/users",
    "test:unit:messaging": "vitest run --project unit-messaging src/use-cases/messaging",
    "test:unit:forms": "vitest run --project unit-forms src/use-cases/forms",
    "test:unit:geo-provider": "vitest run --project unit-geo-provider src/providers/geo-provider",
    "test:unit:address-provider": "vitest run --project unit-address-provider src/providers/address-provider",
    "test:unit:resilient-cache": "vitest run --project unit-resilient-cache src/lib/infra/cache",
    "test:unit:rate-limiter": "vitest run --project unit-rate-limiter src/lib/infra/rate-limiter",
    "test:e2e": "vitest run --project e2e",
    "test:watch": "vitest --project unit",
    "test:e2e:watch": "vitest --project e2e",
    "test:e2e:users": "vitest run --project e2e src/http/controllers/users",
    "test:e2e:api-providers-fallback-strategy": "vitest run --project e2e-api-providers-fallback-strategy",
    "test:unit:all": "vitest run --project=unit-core --project=unit-providers-helpers --project=unit-errors --project=unit-use-cases --project=unit-churches --project=unit-users --project=unit-messaging --project=unit-forms --project=unit-geo-provider --project=unit-address-provider --project=unit-http --project=unit-http-users --project=unit-church-routing-provider --project=unit-lib --project=unit-resilient-cache --project=unit-rate-limiter --project=unit-repositories",
    "test:unit": "npm run test:unit:all",
    "test:acceptance": "vitest run --project acceptance",
    "test:integration": "npm run test:e2e",
    "test:integration:cache": "vitest run --project integration-cache",
    "test:integration:full": "vitest run --project integration",
    "test:mutation": "stryker run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint:complexity": "eslint src/ --max-warnings 0",
    "check:cycles": "dpdm --no-warning --no-tree --exit-code circular:1 src/server.ts src/worker.ts",
    "verify": "run-s typecheck lint test:unit test:acceptance",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:validate": "prisma validate",
    "ci:static": "run-s typecheck lint format:check prisma:validate knip",
    "ci:local": "bash scripts/ci-local.sh"
  },
  "prisma": {
    "seed": "npm run prisma:seed"
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/jwt": "10.2.2",
    "@fastify/rate-limit": "10.3.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/node": "10.73.0",
    "@sentry/profiling-node": "10.73.0",
    "axios": "1.20.0",
    "bcryptjs": "3.0.3",
    "bullmq": "5.81.4",
    "close-with-grace": "2.5.0",
    "cockatiel": "4.0.0",
    "cpf-cnpj-validator": "1.0.3",
    "dotenv": "17.4.2",
    "fastify": "5.12.3",
    "fastify-metrics": "13.2.1",
    "fastify-plugin": "5.1.0",
    "ioredis": "5.11.1",
    "ms": "2.1.3",
    "node-cron": "4.6.0",
    "nodemailer": "7.0.13",
    "pg": "8.23.0",
    "pino": "9.14.0",
    "prom-client": "15.1.3",
    "rate-limiter-flexible": "9.1.1",
    "uuid": "11.1.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "7.0.0",
    "@eslint/js": "9.39.5",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/ms": "2.1.0",
    "@types/node": "24.13.3",
    "@types/nodemailer": "7.0.12",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "dpdm": "4.3.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.6",
    "fast-check": "4.9.0",
    "globals": "14.0.0",
    "husky": "9.1.7",
    "knip": "6.34.0",
    "lint-staged": "16.4.0",
    "npm-run-all": "4.1.5",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "7.3.6",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.11"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.53.3"
  },
  "overrides": {
    "typed-rest-client": {
      "qs": "6.16.0"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    },
    "prisma": {
      "mysql2": "3.23.1"
    },
    "tsup": {
      "esbuild": "0.28.2"
    }
  }
}
