{
  "name": "evangelismo-digital-backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "prepare": "husky || true",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsup src/server.ts src/worker.ts --format cjs --clean",
    "start:dev": "npm run dev",
    "start:prod": "node dist/server.js",
    "start:worker": "tsx watch --env-file=.env src/worker.ts",
    "start:worker:prod": "node dist/worker.js",
    "format": "prettier --write \"src/**/*.{ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js}\"",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:dev:default": "prisma migrate dev --name creating_database_models",
    "db:migrate:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:reset": "run-s db:generate db:migrate:reset db:seed",
    "db:migrate-deploy": "prisma migrate deploy",
    "db:deploy": "run-s db:migrate-deploy db:generate db:seed",
    "test:unit:use-cases": "vitest run --project unit-use-cases src/use-cases",
    "test:unit:churches": "vitest run --project unit-churches src/use-cases/churches",
    "test:unit:users": "vitest run --project unit-users src/use-cases/users",
    "test:unit:messaging": "vitest run --project unit-messaging src/use-cases/messaging",
    "test:unit:forms": "vitest run --project unit-forms src/use-cases/forms",
    "test:unit:geo-provider": "vitest run --project unit-geo-provider src/providers/geo-provider",
    "test:unit:address-provider": "vitest run --project unit-address-provider src/providers/address-provider",
    "test:unit:resilient-cache": "vitest run --project unit-resilient-cache src/lib/redis/helper/resilient-cache.spec.ts",
    "test:unit:rate-limiter": "vitest run --project unit-rate-limiter src/lib/redis/helper/rate-limiter.spec.ts",
    "test:e2e": "vitest run --project e2e",
    "test:watch": "vitest --project unit",
    "test:e2e:watch": "vitest --project e2e",
    "test:e2e:users": "vitest run --project e2e src/http/controllers/users",
    "test:e2e:api-providers-fallback-strategy": "vitest run --project e2e-api-providers-fallback-strategy",
    "test:unit:all": "vitest run --project=unit-errors --project=unit-use-cases --project=unit-churches --project=unit-users --project=unit-messaging --project=unit-forms --project=unit-geo-provider --project=unit-address-provider --project=unit-http --project=unit-http-users --project=unit-church-routing-provider --project=unit-lib --project=unit-resilient-cache --project=unit-rate-limiter",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:validate": "prisma validate",
    "ci:static": "run-s typecheck lint format:check prisma:validate knip",
    "ci:local": "bash scripts/ci-local.sh"
  },
  "prisma": {
    "seed": "npm run prisma:seed"
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fastify/cookie": "11.1.0",
    "@fastify/cors": "11.1.0",
    "@fastify/jwt": "10.0.0",
    "@fastify/rate-limit": "10.3.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@sentry/node": "10.66.0",
    "@sentry/profiling-node": "10.66.0",
    "@types/node-cron": "3.0.11",
    "axios": "1.18.1",
    "bcryptjs": "3.0.2",
    "bullmq": "5.66.0",
    "close-with-grace": "2.5.0",
    "cpf-cnpj-validator": "1.0.3",
    "dotenv": "17.4.2",
    "fastify": "5.10.0",
    "fastify-metrics": "13.2.1",
    "fastify-plugin": "5.0.1",
    "ioredis": "5.9.3",
    "ms": "2.1.3",
    "node-cron": "4.2.1",
    "nodemailer": "7.0.13",
    "pg": "8.16.3",
    "pino": "9.9.0",
    "prom-client": "15.1.3",
    "rate-limiter-flexible": "9.0.1",
    "uuid": "11.1.1",
    "zod": "4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@types/ms": "2.1.0",
    "@types/node": "24.3.0",
    "@types/nodemailer": "7.0.0",
    "@types/pg": "8.16.0",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "eslint": "9.33.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.4",
    "globals": "14.0.0",
    "husky": "9.1.7",
    "knip": "6.27.0",
    "lint-staged": "16.4.0",
    "npm-run-all": "4.1.5",
    "pino-pretty": "13.1.1",
    "prettier": "3.6.2",
    "prisma": "7.8.0",
    "supertest": "7.1.4",
    "tsup": "8.5.0",
    "tsx": "4.20.4",
    "typescript": "5.9.2",
    "typescript-eslint": "8.40.0",
    "vite": "7.3.6",
    "vite-tsconfig-paths": "6.0.3",
    "vitest": "4.1.10"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.53.3"
  }
}
