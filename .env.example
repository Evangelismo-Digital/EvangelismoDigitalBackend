NODE_ENV=development
LOG_LEVEL=info
PROJECT_NAME=evangelismodigital

# App
APP_NAME="Projeto Evangelismo Digital"
APP_PORT=3333
JWT_SECRET=replace-with-a-random-string-of-at-least-60-characters-do-not-commit
COOKIE_SECRET=replace-with-a-random-string-of-at-least-32-characters-do-not-commit
# Rotation window. Leave empty except while rotating: promote the current
# COOKIE_SECRET here, generate a new one above, deploy, and remove this value
# only after a window at least as long as the visitor cookie's 13-month life.
# Cookies signed with either value stay valid; new ones are signed with the
# first. Must be >= 32 characters when set; a blank value counts as unset.
# COOKIE_SECRET_PREVIOUS=
# Shared secret the Next.js analytics proxy sends as `X-Analytics-Proxy`.
# Requests to /analytics without a matching header are refused with 401, so this
# must be identical here and in the frontend's ANALYTICS_PROXY_SECRET.
# Required in every environment; must be >= 32 characters.
ANALYTICS_PROXY_SECRET=replace-with-a-random-string-of-at-least-32-characters-do-not-commit
FRONTEND_URL=http://localhost:5173
HASH_SALT_ROUNDS=12

# Seed data (dev/local only)
SEED_ADMIN_PASSWORD=ChangeMe123!SeedAdmin

# HTTP rate limits
HTTP_RATE_LIMIT_GLOBAL_MAX=300
HTTP_RATE_LIMIT_GLOBAL_TIME_WINDOW="1 minute"
HTTP_RATE_LIMIT_AUTH_SESSION_MAX=15
HTTP_RATE_LIMIT_AUTH_SESSION_TIME_WINDOW="1 minute"
HTTP_RATE_LIMIT_AUTH_REGISTER_MAX=5
HTTP_RATE_LIMIT_AUTH_REGISTER_TIME_WINDOW="1 minute"
HTTP_RATE_LIMIT_AUTH_FORGOT_PASSWORD_MAX=5
HTTP_RATE_LIMIT_AUTH_FORGOT_PASSWORD_TIME_WINDOW="1 hour"
HTTP_RATE_LIMIT_AUTH_RESET_PASSWORD_MAX=5
HTTP_RATE_LIMIT_AUTH_RESET_PASSWORD_TIME_WINDOW="1 hour"
HTTP_RATE_LIMIT_USERS_LIST_MAX=20
HTTP_RATE_LIMIT_USERS_LIST_TIME_WINDOW="1 hour"
HTTP_RATE_LIMIT_USERS_DELETE_MAX=10
HTTP_RATE_LIMIT_USERS_DELETE_TIME_WINDOW="1 hour"
HTTP_RATE_LIMIT_CHURCHES_NEAREST_MAX=30000
HTTP_RATE_LIMIT_CHURCHES_NEAREST_TIME_WINDOW="1 minute"
HTTP_RATE_LIMIT_FORMS_SUBMIT_MAX=60
HTTP_RATE_LIMIT_FORMS_SUBMIT_TIME_WINDOW="1 minute"
HTTP_RATE_LIMIT_HEALTH_CHECK_MAX=120
HTTP_RATE_LIMIT_HEALTH_CHECK_TIME_WINDOW="1 minute"
SENTRY_DSN=
# Amostragem do Sentry (0 a 1). Sem SENTRY_DSN o Sentry é no-op e estes são ignorados.
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILE_SAMPLE_RATE=0.1

# Circuit breaker (resilient provider + cache policies)
# Todos possuem padrão no schema Zod — estas linhas apenas documentam os valores.
# Desligado => a cadeia de políticas é montada sem o breaker, sem custo por chamada.
CIRCUIT_BREAKER_ENABLED=true
# Fração de falhas na janela de amostragem que abre o circuito. Limites
# exclusivos: 0 abriria com o provedor saudável e 1 nunca abriria.
CIRCUIT_BREAKER_FAILURE_THRESHOLD=0.5
CIRCUIT_BREAKER_SAMPLING_WINDOW_MS=30000
# Vazão mínima para o breaker poder abrir, evitando suspender um provedor por
# causa de uma única falha em período ocioso.
CIRCUIT_BREAKER_MIN_THROUGHPUT=5
CIRCUIT_BREAKER_HALF_OPEN_AFTER_MS=10000

# Metrics
METRICS_ENABLED=true
METRICS_API_PORT=9091
METRICS_WORKER_PORT=9092
GRAFANA_ADMIN_PASSWORD=changeme_in_production

# Alertmanager (used only by docker-compose.monitoring.yml — not read by the app).
# Email uses STARTTLS, so 587 (not the app's implicit-TLS 465). Reuses SMTP_* + ADMIN_EMAIL.
ALERTMANAGER_SMTP_PORT=587
# OPTIONAL secondary channel for critical alerts: any Alertmanager-compatible webhook
# endpoint (Discord/Telegram would need a bridge). Leave EMPTY to disable — email still works.
ALERTMANAGER_WEBHOOK_URL=
# OPTIONAL watchdog dead-man's-switch heartbeat (e.g. Healthchecks.io), pinged continuously.
# Leave EMPTY to disable — the watchdog alert is then silently dropped (routed to a blackhole).
WATCHDOG_HEARTBEAT_URL=

# PostgreSQL (consumidos pelo docker-compose e pelo deploy.sh, não pelo schema da app).
# O host/porta do banco vêm de DATABASE_URL abaixo — não existem POSTGRES_HOST/PORT.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=evangelismodigital
# Schema usado pelo ambiente de testes Prisma (prisma-test-environment.ts)
SCHEMA=public

# Pool e timeouts do Postgres (opcionais; padrões do schema abaixo)
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_CONNECTION_TIMEOUT=10000
DB_IDLE_TIMEOUT=30000

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
# Intervalo mínimo entre logs de indisponibilidade do Redis (evita flood)
REDIS_LOG_OUTAGE_INTERVAL_MS=30000
REDIS_PASSWORD=ZP8xM6H4R5A0dJQ7L2WcN3E9yFVkBG

# URLs de conexão
DATABASE_URL="postgresql://postgres:postgres@db:5432/evangelismodigital?schema=public"
DATABASE_URL_LOCAL="postgresql://postgres:postgres@localhost:5432/evangelismodigital?schema=public"
# Only needed to run `prisma migrate diff`/`migrate dev` locally; the DB must already exist.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prisma_shadow?schema=public"

# SMTP
SMTP_EMAIL=your-smtp-user@example.com
SMTP_PASSWORD=replace-with-your-smtp-app-password
SMTP_PORT=465
SMTP_HOST=smtp.gmail.com
SMTP_SECURE=true
# Timeouts defensivos do transporte SMTP (opcionais; padrões abaixo)
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_GREETING_TIMEOUT_MS=5000
SMTP_SOCKET_TIMEOUT_MS=10000

# ADMIN_EMAIL
ADMIN_EMAIL=admin@example.com

# NOMINATIM API
NOMINATIM_API_URL=https://nominatim.openstreetmap.org

LOCATION_IQ_API_URL=https://us1.locationiq.com/v1
LOCATION_IQ_API_TOKEN=pk.replace-with-your-locationiq-token

# VIA CEP API
VIACEP_API_URL=https://viacep.com.br/ws

# AWESOME API
AWESOME_API_URL=https://cep.awesomeapi.com.br
AWESOME_API_TOKEN=replace-with-your-awesomeapi-token

# BRASIL API
BRASIL_API_URL=https://brasilapi.com.br/api/cep/v1

#STADIA MAPS API
# Endpoint da matriz de distâncias (sources_to_targets), lido por
# STADIA_MAPS_MATRIX_API_URL no schema. A chave antiga STADIA_MAPS_API_URL
# (/route/v1) não era lida por nada e foi removida.
STADIA_MAPS_MATRIX_API_URL=https://api.stadiamaps.com/sources_to_targets
STADIA_API_TOKEN=replace-with-your-stadia-maps-token
# Intervalo do health probe do rate limit de entrada (PING no Redis do rate limiter).
# Quando o Redis não responde, o limite é IGNORADO (skipOnError) e este probe é o
# que torna a degradação visível em http_rate_limit_redis_up. Limites: 1s a 5min.
REDIS_RATE_LIMIT_HEALTH_INTERVAL_MS=15000
