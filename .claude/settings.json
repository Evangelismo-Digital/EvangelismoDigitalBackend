{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm run *)",
      "Bash(npx vitest*)",
      "Bash(npx tsc*)",
      "Bash(npx tsup*)",
      "Bash(npx eslint*)",
      "Bash(npx prettier*)",
      "Bash(npx knip*)",
      "Bash(npx stryker*)",
      "Bash(npx cucumber-js*)",
      "Bash(npx dpdm*)",
      "Bash(npx prisma generate*)",
      "Bash(npx prisma validate*)",
      "Bash(npx prisma migrate dev*)",
      "Bash(npx prisma migrate diff*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git checkout -b *)",
      "Bash(git switch*)",
      "Bash(git stash*)",
      "Bash(git restore*)",
      "Bash(docker compose up -d*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose exec*)",
      "Bash(docker compose stop*)",
      "Bash(redis-cli ping)",
      "Edit(src/**)",
      "Edit(features/**)",
      "Edit(prisma/schema.prisma)",
      "Edit(vite.config.mts)",
      "Edit(eslint.config.mjs)",
      "Edit(stryker.conf.mjs)",
      "Edit(.claude/**)",
      "Edit(docs/**)",
      "Edit(*.md)"
    ],
    "deny": [
      "Bash(npm run db:reset)",
      "Bash(npm run db:deploy)",
      "Bash(npm run db:migrate:reset)",
      "Bash(npm run db:migrate-deploy)",
      "Bash(npx prisma migrate deploy*)",
      "Bash(npx prisma migrate reset*)",
      "Bash(npx prisma db push*)",
      "Bash(npx prisma db execute*)",
      "Bash(redis-cli FLUSHALL*)",
      "Bash(redis-cli FLUSHDB*)",
      "Bash(redis-cli * FLUSHALL*)",
      "Bash(redis-cli * FLUSHDB*)",
      "Edit(.env*)",
      "Edit(prisma/migrations/**)",
      "Edit(dist/**)",
      "Edit(docker-compose.prod.yml)",
      "Edit(docker-compose.monitoring.yml)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-and-typecheck.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate.sh",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
