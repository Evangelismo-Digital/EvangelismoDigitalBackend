# Template rendered at container start by docker-entrypoint.sh, which expands the
# placeholders below from the environment (Alertmanager does not expand env vars
# natively and the image lacks envsubst). Keep this file free of shell metacharacters
# other than the intended placeholders, so nothing else is interpreted at render time.
global:
  smtp_smarthost: '${SMTP_HOST}:${ALERTMANAGER_SMTP_PORT}'
  smtp_from: '${SMTP_EMAIL}'
  smtp_auth_username: '${SMTP_EMAIL}'
  smtp_auth_password: '${SMTP_PASSWORD}'
  # Alertmanager only supports STARTTLS (port 587), not implicit TLS (465).
  smtp_require_tls: true

route:
  receiver: 'default'
  group_by: ['alertname', 'environment']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # Watchdog dead-man's-switch: always-firing rule (severity=none, watchdog=true).
    # Routed to a continuous external heartbeat (e.g. Healthchecks.io); its ABSENCE
    # signals that Prometheus/Alertmanager is dead.
    - matchers: ['watchdog="true"']
      receiver: 'watchdog-heartbeat'
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 1m
    # Critical: immediate email + webhook. continue:true so inhibit rules still apply.
    - matchers: ['severity="critical"']
      receiver: 'critical-alerts'
      continue: true
    # Warning: batched email.
    - matchers: ['severity="warning"']
      receiver: 'warning-alerts'

receivers:
  - name: 'default'
    email_configs:
      - to: '${ADMIN_EMAIL}'
        send_resolved: true

  - name: 'critical-alerts'
    email_configs:
      - to: '${ADMIN_EMAIL}'
        send_resolved: true
    webhook_configs:
      - url: '${ALERTMANAGER_WEBHOOK_URL}'
        send_resolved: true

  - name: 'warning-alerts'
    email_configs:
      - to: '${ADMIN_EMAIL}'
        send_resolved: true

  - name: 'watchdog-heartbeat'
    webhook_configs:
      - url: '${WATCHDOG_HEARTBEAT_URL}'
        send_resolved: false

inhibit_rules:
  # A firing critical suppresses same-alertname warnings.
  - source_matchers: ['severity="critical"']
    target_matchers: ['severity="warning"']
    equal: ['alertname']
