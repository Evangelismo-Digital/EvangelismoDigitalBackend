# Template rendered at container start by docker-entrypoint.sh, which expands the
# placeholders below from the environment and strips the optional #IF_.../#ENDIF_...
# blocks when their URL is not configured (Alertmanager rejects an empty url).
# Keep this file free of shell metacharacters other than the intended placeholders.
global:
  smtp_smarthost: '${SMTP_HOST}:${ALERTMANAGER_SMTP_PORT}'
  smtp_from: '${SMTP_EMAIL}'
  smtp_auth_username: '${SMTP_EMAIL}'
  smtp_auth_password: '${SMTP_PASSWORD}'
  # Alertmanager only supports STARTTLS (port 587), not implicit TLS (465).
  smtp_require_tls: true

route:
  receiver: 'default'
  group_by: ['alertname', 'environment']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # Watchdog dead-man's-switch: always-firing rule (severity=none, watchdog=true).
    # Sent to the heartbeat webhook when WATCHDOG_HEARTBEAT_URL is set, otherwise to the
    # 'null' blackhole so it never emails on every repeat.
    - matchers: ['watchdog="true"']
      receiver: '${WATCHDOG_RECEIVER}'
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 1m
    # Critical: immediate email (+ webhook when configured). continue:true so inhibit rules apply.
    - matchers: ['severity="critical"']
      receiver: 'critical-alerts'
      continue: true
    # Warning: batched email.
    - matchers: ['severity="warning"']
      receiver: 'warning-alerts'

receivers:
  - name: 'default'
    email_configs:
      - to: '${ADMIN_EMAIL}'
        send_resolved: true

  - name: 'critical-alerts'
    email_configs:
      - to: '${ADMIN_EMAIL}'
        send_resolved: true
#IF_WEBHOOK
    webhook_configs:
      - url: '${ALERTMANAGER_WEBHOOK_URL}'
        send_resolved: true
#ENDIF_WEBHOOK

  - name: 'warning-alerts'
    email_configs:
      - to: '${ADMIN_EMAIL}'
        send_resolved: true

  # Blackhole receiver (no integrations) — target for the watchdog when no heartbeat URL is set.
  - name: 'null'

#IF_WATCHDOG
  - name: 'watchdog-heartbeat'
    webhook_configs:
      - url: '${WATCHDOG_HEARTBEAT_URL}'
        send_resolved: false
#ENDIF_WATCHDOG

inhibit_rules:
  # A firing critical suppresses same-alertname warnings.
  - source_matchers: ['severity="critical"']
    target_matchers: ['severity="warning"']
    equal: ['alertname']
