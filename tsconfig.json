{
  "compilerOptions": {
    "skipLibCheck": true,
    "lib": ["ES2023"],
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "rootDir": "./src",
    "outDir": "./dist",
    "paths": {
      "app": ["./src/app.ts"],
      "@config/*": ["./src/config/*"],
      "@common/*": ["./src/common/*"],
      "@infra/*": ["./src/infra/*"],
      "@modules/*": ["./src/modules/*"],
      "@tps/*": ["./src/@types/*"]
    },
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.mts", "src/**/*.tsx", "src/load-test/load-test-resilient-cache.k6.js"],
  "exclude": ["node_modules", "dist"]
}
