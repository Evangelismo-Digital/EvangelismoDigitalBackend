save-exact=true
registry=https://registry.npmjs.org/
loglevel=verbose

# Refuse to resolve a version published in the last 7 DAYS.
#
# The npm compromises of the last few years all shared one shape: a maintainer
# account is taken over, a malicious patch release is published, and the
# postinstall runs on every machine that installs within hours. A week's delay
# does not make a package trustworthy, but it puts the whole public detection
# window — advisories, yanked versions, GitHub alerts — in front of us instead
# of behind. Requires npm >= 11.10.
#
# The unit is DAYS, not minutes. Set to 10080 (7 days in minutes) this silently
# became a 27-year cutoff: `npm install <anything-new>` failed with ENOVERSIONS
# while every existing command kept working, because the lockfile pins resolved
# versions and the floor only applies when resolving a new range.
min-release-age=7
