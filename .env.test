# .env.test

# Ambiente
NODE_ENV=test
LOG_LEVEL=error

# App
APP_NAME=Projeto Evangelismo Digital Test
APP_PORT=3333
JWT_SECRET=teste-env-secret-teste-env-secret-teste-env-secret-teste-env-secret-123456
COOKIE_SECRET=teste-env-secret-teste-env-secret-teste-env-secret-teste-env-secret-123456_cookie_secret
FRONTEND_URL=http://localhost:5173
HASH_SALT_ROUNDS=6

# HTTP rate limits for test scenarios
HTTP_RATE_LIMIT_GLOBAL_MAX=300
HTTP_RATE_LIMIT_GLOBAL_TIME_WINDOW=1 minute
HTTP_RATE_LIMIT_AUTH_SESSION_MAX=15
HTTP_RATE_LIMIT_AUTH_SESSION_TIME_WINDOW=1 minute
HTTP_RATE_LIMIT_AUTH_REGISTER_MAX=5
HTTP_RATE_LIMIT_AUTH_REGISTER_TIME_WINDOW=1 minute
HTTP_RATE_LIMIT_AUTH_FORGOT_PASSWORD_MAX=5
HTTP_RATE_LIMIT_AUTH_FORGOT_PASSWORD_TIME_WINDOW=1 hour
HTTP_RATE_LIMIT_AUTH_RESET_PASSWORD_MAX=5
HTTP_RATE_LIMIT_AUTH_RESET_PASSWORD_TIME_WINDOW=1 hour
HTTP_RATE_LIMIT_USERS_LIST_MAX=20
HTTP_RATE_LIMIT_USERS_LIST_TIME_WINDOW=1 hour
HTTP_RATE_LIMIT_USERS_DELETE_MAX=10
HTTP_RATE_LIMIT_USERS_DELETE_TIME_WINDOW=1 hour
HTTP_RATE_LIMIT_CHURCHES_NEAREST_MAX=30000
HTTP_RATE_LIMIT_CHURCHES_NEAREST_TIME_WINDOW=1 minute
HTTP_RATE_LIMIT_FORMS_SUBMIT_MAX=60
HTTP_RATE_LIMIT_FORMS_SUBMIT_TIME_WINDOW=1 minute
HTTP_RATE_LIMIT_HEALTH_CHECK_MAX=120
HTTP_RATE_LIMIT_HEALTH_CHECK_TIME_WINDOW=1 minute

# Metrics
METRICS_ENABLED=false
GRAFANA_ADMIN_PASSWORD=test-grafana-admin-pw

# Database - Docker PostgreSQL (with PostGIS)
# geo-fallback uses this directly with public schema
# Other e2e tests use this as base URL and create unique schemas
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evangelismodigital?schema=public
DATABASE_URL_LOCAL=postgresql://postgres:postgres@localhost:5432/evangelismodigital?schema=public

# Redis - Docker Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=ZP8xM6H4R5A0dJQ7L2WcN3E9yFVkBG

# SMTP
SMTP_EMAIL=test@example.com
SMTP_PASSWORD=test
SMTP_PORT=587
SMTP_HOST=smtp.example.com
SMTP_SECURE=false

# ADMIN
ADMIN_EMAIL=admin@example.com

# NOMINATIM API
NOMINATIM_API_URL=https://nominatim.openstreetmap.org

# Fake tokens: the only project needing real geocoding-API access is
# e2e-api-providers-fallback-strategy, which is excluded from CI (see ci.yml)
# for flakiness. Supply real tokens out-of-band (.env.local, not committed)
# to run that project locally.
LOCATION_IQ_API_URL=https://us1.locationiq.com/v1
LOCATION_IQ_API_TOKEN=pk.test_fake_location_iq_token_00000000

# VIA CEP API
VIACEP_API_URL=https://viacep.com.br/ws

# AWESOME API
AWESOME_API_URL=https://cep.awesomeapi.com.br
AWESOME_API_TOKEN=test_fake_awesome_api_token_0000000000000000000000000000000000

# BRASIL API
BRASIL_API_URL=https://brasilapi.com.br/api/cep/v1

# STADIA MAPS API
STADIA_API_TOKEN=test_fake_stadia_api_token_00000000
